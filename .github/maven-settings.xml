<!--
    Maven settings.xml file for TopQuadrant builds of this fork, which depend on
    TopQuadrant's patched Jena from the TQ Maven repository:

        mvn -s .github/maven-settings.xml install

    You must also set the environment variables TB_NEXUS_USER and
    TB_NEXUS_PASSWORD with valid Nexus credentials.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>dev-all</id>
            <username>${env.TB_NEXUS_USER}</username>
            <password>${env.TB_NEXUS_PASSWORD}</password>
        </server>
    </servers>
    <mirrors>
        <!-- Redirect ALL requests to the Nexus group repository dev-all -->
        <mirror>
            <id>dev-all</id>
            <mirrorOf>*</mirrorOf>
            <url>https://n3.topquadrant.com/repository/dev-all</url>
        </mirror>
    </mirrors>
</settings>
